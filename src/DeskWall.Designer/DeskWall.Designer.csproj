<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>DeskWall.Designer</AssemblyName>
    <RootNamespace>DeskWall.Designer</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The repo default is invariant globalization, which is right for the resident daemon. WPF's
         own control templates do not survive it: opening any ContextMenu throws "Cannot find
         non-neutral culture related to 'en-us'" out of the MultiBinding in the MenuItem template.
         The designer is a desktop editor, not the daemon, so it carries the globalization data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- ThemeMode (the Fluent theme) is still marked experimental in .NET 10. It is the whole point
         of this window's look, so the diagnostic is answered once, here. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeskWall.Core\DeskWall.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\widgets\*.json" Link="widgets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\assets\weather\*.png;..\..\assets\weather\LICENSE" Link="assets\weather\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
