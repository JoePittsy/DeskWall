<UserControl x:Class="DeskWall.Designer.Views.ProvidersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Closed until something has actually been pushed (it opens itself then): most layouts have
       no pushed provider, and the empty note and the test box were a quarter of the column. -->
  <Expander x:Name="Section" IsExpanded="False" Margin="8,4,8,4" AutomationProperties.Name="Pushed values">
    <Expander.Header>
      <TextBlock Text="Pushed" Style="{DynamicResource SectionHeader}"
                 ToolTip="Values another program sends DeskWall. Nothing to declare: bind to one and it appears." />
    </Expander.Header>
  <DockPanel Margin="8,4,8,8">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="False">
      <Button x:Name="ForgetButton" DockPanel.Dock="Right" Content="Forget" Click="Forget_Click"
              Padding="8,2" FontSize="12" Margin="4,0,0,0" IsEnabled="False"
              ToolTip="Stop remembering what this provider last sent" />
      <Button x:Name="DescribeButton" DockPanel.Dock="Right" Content="Describe" Click="Describe_Click"
              Padding="8,2" FontSize="12" IsEnabled="False"
              ToolTip="Write a manifest seeded from what it has sent, so you can name its fields" />
    </DockPanel>

    <TextBlock x:Name="EmptyNote" DockPanel.Dock="Top" Style="{DynamicResource Hint}"
               Text="Nothing has been pushed yet. Write one JSON line to \\.\pipe\DeskWall.Events and it shows up here." />

    <ComboBox x:Name="Chooser" DockPanel.Dock="Top" Margin="0,0,0,6"
              AutomationProperties.Name="Pushed provider"
              SelectionChanged="Chooser_SelectionChanged" Visibility="Collapsed" />

    <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
      <TextBlock x:Name="TestJsonLabel" Text="Test event (JSON)" Style="{DynamicResource Caption}" Margin="0,0,0,3" />
      <DockPanel LastChildFill="True">
        <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Click="Send_Click"
                Padding="8,2" FontSize="12" Margin="4,0,0,0"
                ToolTip="Publish this into the designer only, to design against an event that has not happened yet" />
        <TextBox x:Name="TestJson" FontSize="12" FontFamily="Consolas, Cascadia Mono, monospace"
                 AutomationProperties.LabeledBy="{Binding ElementName=TestJsonLabel}" />
      </DockPanel>
    </StackPanel>

    <ListBox x:Name="Fields" BorderThickness="1" MinHeight="60"
             HorizontalContentAlignment="Stretch"
             AutomationProperties.Name="Pushed fields"
             MouseDoubleClick="Fields_DoubleClick"
             ToolTip="Double-click a row to copy its binding path" />
  </DockPanel>
  </Expander>
</UserControl>
