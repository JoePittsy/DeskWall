<UserControl x:Class="DeskWall.Designer.Views.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DeskWall.Designer.Views">
    <UserControl.Resources>
        <!-- The checkerboard under anything translucent. Two Fluent tokens, so it follows the theme:
             the window background and the disabled strong fill laid over it. -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="Fill">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{DynamicResource SolidBackgroundFillColorBaseBrush}" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="{DynamicResource ControlStrongFillColorDisabledBrush}" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- The colour being picked is content, not chrome: these stops are the hues themselves. -->
        <LinearGradientBrush x:Key="HueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF0000" Offset="0" />
            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
            <GradientStop Color="#FF00FF00" Offset="0.3333" />
            <GradientStop Color="#FF00FFFF" Offset="0.5" />
            <GradientStop Color="#FF0000FF" Offset="0.6667" />
            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
            <GradientStop Color="#FFFF0000" Offset="1" />
        </LinearGradientBrush>

        <!-- Two rings, dark over light (swapped in dark theme): whatever colour sits under the
             thumb, one of the two clears 3:1 against it. -->
        <ControlTemplate x:Key="RingThumb" TargetType="Control">
            <Grid Width="16" Height="16" Background="Transparent">
                <Ellipse Stroke="{DynamicResource TextFillColorPrimaryBrush}" StrokeThickness="2" />
                <Ellipse Margin="2" Stroke="{DynamicResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="2" />
            </Grid>
        </ControlTemplate>

        <!-- A slider drawn as a colour strip: Background is the strip, over the checkerboard. The
             strip is inset by the thumb's radius so the gradient spans exactly the thumb's travel.
             Keyboard, focus and UI Automation are the Slider's own. -->
        <ControlTemplate x:Key="StripSlider" TargetType="Slider">
            <Grid Height="20" Background="Transparent">
                <Border Margin="8,4" CornerRadius="4" Background="{StaticResource Checker}" />
                <Border Margin="8,4" CornerRadius="4" Background="{TemplateBinding Background}" />
                <Track x:Name="PART_Track">
                    <Track.Thumb>
                        <Thumb Template="{StaticResource RingThumb}" />
                    </Track.Thumb>
                </Track>
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>

    <StackPanel>
        <local:ColorArea x:Name="Area" Height="150" Focusable="True" Background="Transparent"
                         AutomationProperties.Name="Saturation and brightness"
                         MouseLeftButtonDown="Area_MouseLeftButtonDown" MouseMove="Area_MouseMove"
                         MouseLeftButtonUp="Area_MouseLeftButtonUp" LostMouseCapture="Area_LostMouseCapture"
                         KeyDown="Area_KeyDown" SizeChanged="Area_SizeChanged">
            <Grid>
                <!-- Square layers under one rounded clip (set on resize): rounding each layer
                     separately lets the hue leak through their anti-aliased corners. -->
                <Grid x:Name="AreaLayers">
                <Rectangle x:Name="HueFill" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                </Grid>
                <Canvas IsHitTestVisible="False">
                    <Control x:Name="AreaThumb" Template="{StaticResource RingThumb}" Focusable="False" IsTabStop="False" />
                </Canvas>
            </Grid>
        </local:ColorArea>

        <Slider x:Name="HueSlider" Margin="-8,8,-8,0" Template="{StaticResource StripSlider}"
                Background="{StaticResource HueGradient}" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15"
                IsMoveToPointEnabled="True" AutomationProperties.Name="Hue" ValueChanged="HueSlider_ValueChanged" />

        <Slider x:Name="AlphaSlider" Margin="-8,4,-8,0" Template="{StaticResource StripSlider}"
                Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                IsMoveToPointEnabled="True" AutomationProperties.Name="Opacity" ValueChanged="AlphaSlider_ValueChanged" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="4" Background="{StaticResource Checker}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    AutomationProperties.Name="Current colour">
                <Border x:Name="Swatch" CornerRadius="3" />
            </Border>
            <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" MaxLength="9"
                     AutomationProperties.Name="Hex colour" AutomationProperties.HelpText="#RGB, #RRGGBB or #AARRGGBB"
                     KeyDown="HexBox_KeyDown" LostKeyboardFocus="HexBox_LostKeyboardFocus" />
        </Grid>

        <!-- The colours already on this layout and widget, one click each: matching what is there
             is the usual job, not inventing a new colour. -->
        <WrapPanel x:Name="SwatchRow" Margin="0,8,0,0" Visibility="Collapsed"
                   AutomationProperties.Name="Colours in use" />
    </StackPanel>
</UserControl>
