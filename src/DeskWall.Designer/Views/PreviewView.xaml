<UserControl x:Class="DeskWall.Designer.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AllowDrop="True"
             FocusVisualStyle="{x:Null}"
             Background="Transparent">
  <Grid x:Name="Root">
    <!-- The surface is added as this border's child in code: it draws the frame, the grid, the
         selection and its grips, and nothing about it is worth expressing as a visual tree. The
         align strip is added to this Grid in code too, because it exists only some of the time. -->
    <Border x:Name="Host" ClipToBounds="True" Background="Transparent" />

    <TextBlock x:Name="DrawingHint" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20,20,420,24"
               Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}" Padding="8" Visibility="Collapsed" TextWrapping="Wrap" />
    <!-- The canvas's own settings, in one strip so they read as chrome rather than as part of the
         wallpaper: whether the grid is drawn, what it (and Shift-snapping) steps by, and the zoom
         (out, the level - which fits all when pressed - and in). The spacing is here even
         when the grid is not drawn, because snapping uses it either way. -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"
            CornerRadius="6" Padding="4" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
      <StackPanel Orientation="Horizontal">
        <ToggleButton x:Name="PenToggle" Content="Pen" Click="DrawingMode_Click" MinWidth="48" Height="28"
                      ToolTip="Click points. Enter finishes an outline; double-click fills it. Escape cancels." AutomationProperties.Name="Pen tool" />
        <ToggleButton x:Name="TraceToggle" Content="Trace" Click="DrawingMode_Click" MinWidth="54" Height="28"
                      ToolTip="Drag a band around the skyline to trace it" AutomationProperties.Name="Trace skyline here" />
        <ToggleButton x:Name="GridToggle" Content="Grid" Click="GridToggle_Click"
                      ToolTip="Draw the grid over the wallpaper"
                      AutomationProperties.Name="Draw the grid"
                      MinWidth="52" Height="28" Padding="8,0" />
        <ComboBox x:Name="GridSpacing" SelectionChanged="GridSpacing_Changed"
                  Width="76" Height="28" Margin="4,0,0,0"
                  ToolTip="Grid spacing. Hold Shift while dragging to snap to it."
                  AutomationProperties.Name="Grid spacing" />
        <Button x:Name="ZoomOutButton" Content="&#x2212;" Click="ZoomOut_Click"
                ToolTip="Zoom out (Ctrl+minus, or Ctrl+wheel)"
                AutomationProperties.Name="Zoom out"
                MinWidth="28" Height="28" Margin="4,0,0,0" Padding="6,0" />
        <Button x:Name="ZoomLabel" Content="100%" Click="ZoomLabel_Click"
                ToolTip="Fit the whole wallpaper in the pane (Shift+1). Shift+2 fits the selection."
                AutomationProperties.Name="Zoom level; fit all"
                MinWidth="56" Height="28" Margin="2,0,0,0" Padding="8,0" />
        <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click"
                ToolTip="Zoom in (Ctrl+plus, or Ctrl+wheel)"
                AutomationProperties.Name="Zoom in"
                MinWidth="28" Height="28" Margin="2,0,0,0" Padding="6,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
