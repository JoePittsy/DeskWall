<UserControl x:Class="DeskWall.Designer.Views.PropertiesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Properties">
  <!-- Everything inside is built in code from PropertyRows; styles are DynamicResource so the panel
       also loads where App.xaml is not (the tests). -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="16">
      <TextBlock x:Name="EmptyText" Text="No selection" Visibility="Collapsed" Style="{DynamicResource Hint}" />
      <StackPanel x:Name="Root" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
