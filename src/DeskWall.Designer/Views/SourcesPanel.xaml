<UserControl x:Class="DeskWall.Designer.Views.SourcesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="Data" Style="{StaticResource SectionHeader}"
                 VerticalAlignment="Center" />
      <Button x:Name="AddButton" DockPanel.Dock="Right" Content="+ Source" Click="Add_Click"
              Padding="10,3" VerticalAlignment="Center"
              ToolTip="Something for this widget to draw" />
    </DockPanel>

    <ListBox x:Name="List" DockPanel.Dock="Top" MaxHeight="120" Margin="0,0,0,8"
             BorderThickness="1" HorizontalContentAlignment="Stretch"
             SelectionChanged="List_SelectionChanged" />

    <TextBlock x:Name="EmptyNote" DockPanel.Dock="Top" Style="{StaticResource Hint}"
               Text="Nothing yet. A clock needs time, a dial needs hardware, and your own feed needs http, command or file." />

    <StackPanel x:Name="Form" DockPanel.Dock="Top" Margin="0,0,0,8" />

    <DockPanel x:Name="FormActions" DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False"
               Visibility="Collapsed">
      <Button x:Name="RefreshButton" DockPanel.Dock="Left" Content="Refresh" Click="Refresh_Click"
              Padding="10,3" ToolTip="Read this source again now" />
      <Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="Remove" Click="Remove_Click"
              Padding="10,3" ToolTip="Take this source out of the widget" />
    </DockPanel>

    <TreeView x:Name="ValueTree" BorderThickness="1" />
  </DockPanel>
</UserControl>
