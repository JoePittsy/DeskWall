<UserControl x:Class="DeskWall.Designer.Views.SourcesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button x:Name="AddButton" Content="Add source" Margin="0,0,4,0" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="Remove" Margin="0,0,4,0" Click="RemoveButton_Click"/>
            <Button x:Name="RefreshButton" Content="Refresh now" Click="RefreshButton_Click"/>
        </StackPanel>
        <ListBox x:Name="List" DockPanel.Dock="Top" MaxHeight="180"
                 HorizontalContentAlignment="Stretch"
                 BorderThickness="0,1,0,1"
                 BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                 SelectionChanged="List_SelectionChanged"
                 MouseDoubleClick="List_MouseDoubleClick"/>
        <TreeView x:Name="ValueTree" BorderThickness="0"/>
    </DockPanel>
</UserControl>
