<Window x:Class="DeskWall.Designer.Views.FirstRun"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskWall - choose a layout"
        Width="1180" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Rows="1" Columns="3">
            <Border Margin="8" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Column" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="Clock, recently played Steam games and drive space in a right-hand column." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom" Content="Use this" Tag="starter-column.json" Click="UseStarter_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Border Background="Black" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1">
                        <Image x:Name="ColumnPreview" Stretch="Uniform" MaxWidth="320" />
                    </Border>
                </DockPanel>
            </Border>

            <Border Margin="8" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Clock" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="Just the clock, top right. Nothing else on the wallpaper." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom" Content="Use this" Tag="starter-clock.json" Click="UseStarter_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Border Background="Black" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1">
                        <Image x:Name="ClockPreview" Stretch="Uniform" MaxWidth="320" />
                    </Border>
                </DockPanel>
            </Border>

            <Border Margin="8" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1" Padding="16">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="Blank" FontWeight="Bold" FontSize="16" Margin="0,0,0,4" />
                    <TextBlock DockPanel.Dock="Top" Text="Just the base photo. A clean start to build your own layout." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button DockPanel.Dock="Bottom" Content="Use this" Tag="starter-blank.json" Click="UseStarter_Click" Padding="10,4" HorizontalAlignment="Left" Margin="0,12,0,0" />
                    <Border Background="Black" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1">
                        <Image x:Name="BlankPreview" Stretch="Uniform" MaxWidth="320" />
                    </Border>
                </DockPanel>
            </Border>
        </UniformGrid>

        <Button Grid.Row="1" Content="Open an existing layout file..." Click="OpenExisting_Click"
                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="10,4" />
    </Grid>
</Window>
