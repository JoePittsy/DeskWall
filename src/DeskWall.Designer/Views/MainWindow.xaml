<Window x:Class="DeskWall.Designer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DeskWall.Designer.Views"
        Title="DeskWall Designer"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Five things: what is open, and the four verbs. Undo and Redo are glyphs because they are
         universal and a word each would read as a menu bar; Apply is the only accent on the screen,
         which is what makes it the obvious thing to do. -->
    <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <DockPanel LastChildFill="False">
        <!-- The name of the layout in use is also where another is chosen (#73): the fact and the
             way to change it are one element, so the bar gains a chevron, not a control. -->
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <Button x:Name="LayoutPicker" Click="LayoutPicker_Click" HorizontalAlignment="Left"
                  Padding="6,1" Margin="-7,-2,0,-1" BorderThickness="0" Background="Transparent"
                  AutomationProperties.Name="Layout in use: choose another">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="LayoutNameText" FontSize="14" FontWeight="SemiBold"
                         MaxWidth="560" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
              <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                         Margin="8,2,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
          </Button>
          <TextBlock x:Name="DisplayText" FontSize="12" Margin="0,1,0,0"
                     MaxWidth="560" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Where the canvas is editing: "Layout", or "Layout > <widget> (copy)" / "(widget)".
             Always visible, because the three depths share one canvas and only this says which. -->
        <TextBlock x:Name="Breadcrumb" DockPanel.Dock="Left" FontSize="14" Margin="32,0,0,0"
                   VerticalAlignment="Center" MaxWidth="560" TextTrimming="CharacterEllipsis"
                   AutomationProperties.Name="Editing depth"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   ToolTip="Enter goes down a depth, Esc comes back up. Ctrl+Alt+K edits the selected widget, or makes one from loose parts." />

        <!-- Icon buttons carry the icon font on the glyph, never on the button: a string tooltip
             inherits the button's font and renders as boxes. -->
        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="Settings_Click"
                ToolTip="Settings" AutomationProperties.Name="Settings"
                Width="36" Height="32" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply" Click="Apply_Click"
                Style="{DynamicResource AccentButtonStyle}" ToolTip="Apply (Ctrl+S)"
                MinWidth="96" Height="32" Margin="16,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="RedoButton" DockPanel.Dock="Right" Click="Redo_Click"
                ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"
                Width="36" Height="32" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
        <Button x:Name="UndoButton" DockPanel.Dock="Right" Click="Undo_Click"
                ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"
                Width="36" Height="32" Padding="0" VerticalAlignment="Center">
          <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
        </Button>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="348" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <!-- Layers above Insert (brief 6): what is on the canvas, then what can go on it. Layers is as
           tall as its rows, up to a share of the column (LeftColumn_SizeChanged), so an empty or short
           layout leaves Insert the room; the splitter between them is the owner's to move, and is
           remembered. -->
      <Grid Grid.Column="0" x:Name="LeftColumn" SizeChanged="LeftColumn_SizeChanged">
        <Grid.RowDefinitions>
          <RowDefinition x:Name="LayersRow" Height="Auto" MinHeight="72" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="240" />
        </Grid.RowDefinitions>
        <v:LayersPanel x:Name="Layers" Grid.Row="0" AutomationProperties.Name="Layers panel"
                       ToolTip="Tab / Shift+Tab: next / previous. Ctrl+A: all. Ctrl+C, Ctrl+V, Ctrl+D: copy, paste, duplicate. Ctrl+] / Ctrl+[: bring to front / send to back. Delete: remove." />
        <GridSplitter x:Name="LayersSplitter" Grid.Row="1" Height="10" HorizontalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      DragStarted="LayersSplitter_DragStarted" DragCompleted="LayersSplitter_DragCompleted"
                      PreviewKeyDown="LayersSplitter_Key" KeyUp="LayersSplitter_Key"
                      ToolTip="Drag to share the column between Layers and Insert"
                      AutomationProperties.Name="Resize Layers and Insert" />
        <v:InsertPanel x:Name="Insert" Grid.Row="2" />
      </Grid>

      <Border Grid.Column="1" BorderThickness="1,0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <Grid>
          <v:PreviewView x:Name="Preview" />
          <!-- Widget depth, however it was reached (Enter, double-click, Ctrl+Alt+K, Insert > Edit):
               what an edit here reaches, and that Apply forks a shipped widget. Top-left, clear of
               the align strip (top centre) and the shortcut sheet (top right). -->
          <Border x:Name="DepthBanner" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Margin="16" MaxWidth="560" CornerRadius="6" BorderThickness="4,1,1,1" Padding="12,7"
                  Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                  BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock x:Name="DepthBannerText" TextWrapping="Wrap" FontSize="13"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          </Border>
          <!-- F1 or ?: every key, over the canvas's top-right corner. Not a dialog: the canvas stays
               live under it and the focus stays where it was. Filled from Model.Shortcuts. -->
          <Border x:Name="ShortcutSheet" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Margin="16" Width="380" CornerRadius="8" BorderThickness="1" Padding="16,12,8,12"
                  AutomationProperties.Name="Keyboard shortcuts"
                  Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                  BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="0,0,8,8">
                <Button DockPanel.Dock="Right" Click="CloseShortcuts_Click"
                        Width="28" Height="28" Padding="0" ToolTip="Close (F1 or Esc)"
                        AutomationProperties.Name="Close keyboard shortcuts">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                </Button>
                <TextBlock Text="Keyboard shortcuts" Style="{DynamicResource SectionHeader}" VerticalAlignment="Center" />
              </DockPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560" Padding="0,0,8,0">
                <StackPanel x:Name="ShortcutList" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Grid>
      </Border>

      <!-- Properties above, pushed values below: both answer "what can this widget say", and a pushed
           provider has to be visible somewhere for a user to know it is arriving at all. At widget
           depth the widget's own sources sit between them: what it reads, and the live answer. -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <v:PropertiesPanel x:Name="Properties" Grid.Row="0" />
        <Border x:Name="SourcesHost" Grid.Row="1" BorderThickness="0,1,0,0" MaxHeight="420" Padding="16,12"
                Visibility="Collapsed" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
          <v:SourcesPanel x:Name="Sources" AutomationProperties.Name="Widget sources" />
        </Border>
        <Border Grid.Row="2" BorderThickness="0,1,0,0" MaxHeight="260"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
          <v:ProvidersPanel x:Name="Providers" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="16,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <TextBlock x:Name="StatusText" FontSize="12" AutomationProperties.LiveSetting="Polite"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Border>
  </Grid>
</Window>
