<Window x:Class="DeskWall.Designer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:DeskWall.Designer.Views"
        Title="DeskWall Designer"
        Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Five things: what is open, and the four verbs. Undo and Redo are glyphs because they are
         universal and a word each would read as a menu bar; Apply is the only accent on the screen,
         which is what makes it the obvious thing to do. -->
    <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock x:Name="LayoutNameText" FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
          <TextBlock x:Name="DisplayText" FontSize="12" Margin="0,1,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Click="Settings_Click"
                Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                Width="36" Height="32" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="ApplyButton" DockPanel.Dock="Right" Content="Apply" Click="Apply_Click"
                Style="{DynamicResource AccentButtonStyle}" ToolTip="Ctrl+S"
                MinWidth="96" Height="32" Margin="16,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="RedoButton" DockPanel.Dock="Right" Click="Redo_Click"
                Content="&#xE7A6;" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                Width="36" Height="32" Padding="0" Margin="4,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="UndoButton" DockPanel.Dock="Right" Click="Undo_Click"
                Content="&#xE7A7;" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                Width="36" Height="32" Padding="0" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="348" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>

      <v:GalleryPanel x:Name="Gallery" Grid.Column="0" />

      <Border Grid.Column="1" BorderThickness="1,0"
              BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
              Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}">
        <v:PreviewView x:Name="Preview" />
      </Border>

      <v:KnobsPanel x:Name="Knobs" Grid.Column="2" />
    </Grid>

    <Border Grid.Row="2" Padding="16,6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
      <TextBlock x:Name="StatusText" FontSize="12"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
    </Border>
  </Grid>
</Window>
