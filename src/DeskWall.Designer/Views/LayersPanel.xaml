<UserControl x:Class="DeskWall.Designer.Views.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="8,8,8,8">
    <TextBlock DockPanel.Dock="Top" Text="Layers" Style="{DynamicResource SectionHeader}" Margin="8,0,0,4" />
    <TextBlock x:Name="EmptyNote" DockPanel.Dock="Top" Style="{DynamicResource Hint}" Margin="8,0,0,0"
               Text="Nothing placed yet. Drag a widget, a part or a value in from Insert." Visibility="Collapsed" />
    <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent"
              AutomationProperties.Name="Layers"
              KeyboardNavigation.TabNavigation="Once"
              SelectedItemChanged="Tree_SelectedItemChanged" />
  </DockPanel>
</UserControl>
