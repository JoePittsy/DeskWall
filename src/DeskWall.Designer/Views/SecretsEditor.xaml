<Window x:Class="DeskWall.Designer.Views.SecretsEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeskWall.Designer.Views"
        Title="Secrets" Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        FontFamily="{x:Static SystemFonts.MessageFontFamily}">
    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Referenced from a layout as {secret:name}. Values are never written to the log."
                   TextWrapping="Wrap" Margin="0,0,0,8" />

        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows" AutomationProperties.Name="Secrets">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"
                                         AutomationProperties.Name="Secret name" />
                                <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding Revealed, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0"
                                         AutomationProperties.Name="{Binding Key, StringFormat='Value of {0}'}" />
                                <TextBox Grid.Column="1" Text="{Binding Masked, Mode=OneWay}" IsReadOnly="True"
                                         Visibility="{Binding Revealed, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" Margin="0,0,6,0"
                                         AutomationProperties.Name="{Binding Key, StringFormat='Value of {0} (hidden)'}" />
                                <ToggleButton Grid.Column="2" IsChecked="{Binding Revealed}" Content="Reveal" Width="60" Margin="0,0,6,0"
                                              AutomationProperties.Name="{Binding Key, StringFormat='Reveal {0}'}" />
                                <Button Grid.Column="3" Content="Remove" Click="Remove_Click" Tag="{Binding}" Width="60"
                                        AutomationProperties.Name="{Binding Key, StringFormat='Remove {0}'}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="2" Content="Add" Click="Add_Click" HorizontalAlignment="Left" Padding="10,4" Margin="0,8,0,0" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="Save" Click="Save_Click" Padding="10,4" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
