<UserControl x:Class="DeskWall.Designer.Views.BindingChip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Styles are DynamicResource so the control still loads where App.xaml is not (the tests). -->
  <StackPanel>
    <Button x:Name="Chip" Style="{DynamicResource BindingChipButton}" HorizontalAlignment="Left"
            Click="Chip_Click">
      <TextBlock x:Name="ChipText" TextTrimming="CharacterEllipsis" />
    </Button>

    <Border x:Name="EditorPanel" Visibility="Collapsed" Style="{DynamicResource BindingChipEditor}"
            KeyboardNavigation.TabNavigation="Continue">
      <StackPanel>
        <Grid>
          <TextBox x:Name="Search" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown" />
          <TextBlock x:Name="SearchHint" Text="Search live values" IsHitTestVisible="False"
                     Margin="11,0,0,0" VerticalAlignment="Center"
                     Style="{DynamicResource Hint}" />
        </Grid>
        <ListBox x:Name="Matches" MaxHeight="220" Margin="0,4,0,0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseLeftButtonUp="Matches_PreviewMouseLeftButtonUp"
                 PreviewKeyDown="Matches_PreviewKeyDown"
                 SelectionChanged="Matches_SelectionChanged" />
        <TextBlock x:Name="NoMatches" Visibility="Collapsed" Margin="0,4,0,0" Style="{DynamicResource Hint}" />
        <DockPanel x:Name="FormatRow" Margin="0,8,0,0">
          <TextBlock x:Name="FormatLabel" Text="Show as" DockPanel.Dock="Left" VerticalAlignment="Center"
                     Margin="0,0,8,0" Style="{DynamicResource PropLabel}" />
          <ComboBox x:Name="FormatBox" SelectionChanged="FormatBox_SelectionChanged" />
        </DockPanel>
        <StackPanel x:Name="RulesPanel" Margin="0,8,0,0" Visibility="Collapsed">
          <DockPanel>
            <TextBlock Text="Rules" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                       Style="{DynamicResource PropLabel}" />
            <ComboBox x:Name="RulesMode" SelectionChanged="RulesMode_SelectionChanged">
              <ComboBoxItem Content="None" />
              <ComboBoxItem Content="Step: ranges pick a value" />
              <ComboBoxItem Content="Blend: slide between values" />
            </ComboBox>
          </DockPanel>
          <StackPanel x:Name="RuleRows" Margin="0,4,0,0" />
          <Button x:Name="AddRuleButton" Content="+ Add" HorizontalAlignment="Left" Padding="8,2" Margin="0,4,0,0"
                  Click="AddRule_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button x:Name="UnbindButton" Content="Unbind" Padding="12,4" Margin="0,0,8,0" Click="UnbindButton_Click" />
          <Button x:Name="DoneButton" Content="Done" Padding="12,4" Click="DoneButton_Click" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
