<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>deskwall</AssemblyName>
    <RootNamespace>DeskWall.Daemon</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>true</StackTraceSupport>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shared with the designer (assets\deskwall.ico) so the tray icon and the designer's window
         cannot drift apart. The tray reads this back out of the exe as resource 32512. -->
    <ApplicationIcon>..\..\assets\deskwall.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeskWall.Core\DeskWall.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shipped widgets (WidgetCatalog.ShippedDir), so a dev deskwall expands v2 copies exactly
         as the install does. The designer links the same files; publish.ps1's merge skips
         hash-identical files, so the install is unaffected. -->
    <None Include="..\..\widgets\*.json" Link="widgets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
