{
  "version": 1,
  "name": "Volume",
  "description": "Master playback volume, pushed by the sound card the moment it moves. Red when muted.",
  "size": [80, 80],
  "sources": [
    { "name": "audio", "type": "audio" }
  ],
  "components": [
    { "type": "dial", "id": "dial", "rect": [0, 0, 80, 80], "z": 1, "fraction": { "bind": "audio.volume" },
      "fill": { "bind": "audio.muted | \"?true=#FFD13438,*=#EBFFFFFF\"" } },
    { "type": "text", "id": "value", "rect": [0, 26, 80, 28], "z": 2, "text": { "bind": "audio.volumePct | \"{0}%\"" },
      "size": 18, "align": "center", "color": { "bind": "audio.muted | \"?true=#FFD13438,*=#EBFFFFFF\"" },
      "effect": "none", "effectRadius": 6 },
    { "type": "text", "id": "label", "rect": [0, 62, 80, 16], "z": 2, "text": { "bind": "audio.muted | \"?true=muted,*=vol\"" },
      "size": 11, "align": "center", "color": { "bind": "audio.muted | \"?true=#FFD13438,*=#A0FFFFFF\"" },
      "effect": "none", "effectRadius": 6 }
  ],
  "knobs": []
}
