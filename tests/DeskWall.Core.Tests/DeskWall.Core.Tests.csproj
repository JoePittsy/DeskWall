<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <!-- Keeps Category=Budget out of the default run; see the runsettings for why. VSTest ANDs a
         runsettings TestCaseFilter with the one from the command line, so "Category!=Budget" would
         make "Category=Budget" match nothing: the runsettings is therefore stood down whenever a
         filter is given, and the command line's filter is then the only one in force. -->
    <RunSettingsFilePath Condition="'$(VSTestTestCaseFilter)' == ''">$(MSBuildThisFileDirectory)..\deskwall.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskWall.Core\DeskWall.Core.csproj" />
    <!-- The pipe server lives in the daemon, because two processes cannot own one pipe name, and
         there is no daemon test project; referencing the exe is how its host types get tested. -->
    <ProjectReference Include="..\..\src\DeskWall.Daemon\DeskWall.Daemon.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Golden PNGs, the checked-in cover image and the layout JSONs the golden-image tests
         render, deployed next to the test binaries so GoldenTests can find them via
         AppContext.BaseDirectory regardless of where the test host runs from. -->
    <None Include="Goldens\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Goldens\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
