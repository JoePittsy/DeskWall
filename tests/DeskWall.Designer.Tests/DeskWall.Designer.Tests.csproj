<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <!-- Keeps Category=Desktop (tests that show real windows) out of the default run; same
         runsettings, and the same stand-down on a command-line filter, as DeskWall.Core.Tests. -->
    <RunSettingsFilePath Condition="'$(VSTestTestCaseFilter)' == ''">$(MSBuildThisFileDirectory)..\deskwall.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Gives the run its own DESKWALL_HOME and temp root, shared by both test projects. -->
    <Compile Include="..\Shared\TestRun.cs" Link="TestRun.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskWall.Designer\DeskWall.Designer.csproj" />
  </ItemGroup>
</Project>
